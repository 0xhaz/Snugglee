{
  "expo": {
    "name": "Snugglee",
    "slug": "snugglee",
    "scheme": "snugglee",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#2C2C4D",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.snugglee.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.snugglee.app",
      "adaptiveIcon": {
        "backgroundColor": "#2C2C4D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Snugglee uses your microphone to record a short sample of your voice, so your child can hear their story read by you.",
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#2C2C4D"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "revenuecatIosKey": "appl_NTFXTbBedcaFRtYmIHkNtrXYSmG",
      "revenuecatAndroidKey": "",
      "router": {},
      "eas": {
        "projectId": "7df575ce-8275-4586-ac52-a452ff469d35"
      },
      "googleWebClientId": "75574145355-te5aj4gbppspi073g5dth8nq7emh25st.apps.googleusercontent.com",
      "googleIosClientId": "75574145355-156pmdan1sqhgegn0gl17j5fdaf9988b.apps.googleusercontent.com"
    },
    "owner": "0xhaz",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7df575ce-8275-4586-ac52-a452ff469d35"
    }
  }
}
