rules_version = '2';

// Snugglee — Firestore security rules.
//
// DENY EVERYTHING. That is the intended posture, not an oversight.
//
// Nothing in this product reads Firestore from a client. The mobile app imports
// `firebase/app` and `firebase/auth` only (see mobile/src/session.ts) — it never
// imports `firebase/firestore`. Every read and write goes through the
// authenticated Hono API, which uses the Admin SDK.
//
// The Admin SDK is unaffected by this file: it authenticates as a service
// account and is authorised by IAM, which bypasses Security Rules entirely. So
// locking clients out costs the server nothing.
//
// Why bother if no client connects? Because the Firebase Web API key ships
// inside the app (it is a project identifier, not a credential, and that is by
// design). Anyone can extract it and point a Firestore client SDK at the
// project. Rules are the only thing standing between that and the data —
// ledger balances, voice records and consent grants.
//
// Before this file existed the project had NO ruleset and NO release at all,
// which left that behaviour implicit rather than stated. This makes it explicit
// and auditable.
//
// If a client ever genuinely needs direct Firestore access, add a narrow match
// block for that collection — never widen this one.
//
// Deploy:  firebase deploy --only firestore:rules --project snugglee-prod
// Verify:  firebase firestore:rules get --project snugglee-prod

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
