# Snugglee harness — local secrets. Copy to `.env.local` (gitignored).
#
# These keys are read ONLY by the Vite dev middleware (harness/proxy/*), which
# runs in Node, not in the browser. They are never bundled into client code.
# This mirrors the production rule from techstacks.md §1: no API keys in the
# client, ever. All vendor calls proxy through a server.


# ─────────────────────────────────────────────────────────────────────────────
# 1. GOOGLE AI (GEMINI)  — required for SPIKE-01 (gating) and SPK-03
# ─────────────────────────────────────────────────────────────────────────────
# One key covers image gen (Nano Banana family), story text (Flash-Lite) and
# the safety classifier.
#
# A key already exists for the snugglee-prod project. Fetch it with:
#
#   gcloud services api-keys list --project=snugglee-prod \
#     --filter="displayName:'Snugglee harness (local dev)'" --format="value(name)"
#   gcloud services api-keys get-key-string <NAME> --project=snugglee-prod
#
# Or make a fresh one in AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# 2. MINIMAX  — required for the O-02 bake-off (Wed Jul 29)
# ─────────────────────────────────────────────────────────────────────────────
# Sign up:  https://platform.minimax.io
# Docs:     https://platform.minimax.io/docs/
# Pricing:  https://platform.minimax.io/subscribe/token-plan
#
# Use the .io platform, NOT minimaxi.com — the latter is the China-mainland
# console and issues keys that do not work against the international API.
#
# Both values live in the console once you are logged in: the API key under
# account/API keys, and GroupId under account info. MiniMax passes GroupId as a
# query parameter on most audio endpoints, which is unusual and easy to miss.
#
# Prior favourite (techstacks.md §5): its timbre/content separation targets
# exactly our input — accented amateur, phone mic, 15 seconds.
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# Optional. Defaults to https://api.minimax.io (international).
# The China-mainland endpoint is https://api.minimax.chat — sending an
# international key there returns {"status_code":2049,"invalid api key"},
# which reads like a bad key and is not.
MINIMAX_BASE_URL=


# ─────────────────────────────────────────────────────────────────────────────
# 3. CARTESIA  — required for the O-02 bake-off (Wed Jul 29)
# ─────────────────────────────────────────────────────────────────────────────
# Keys:     https://play.cartesia.ai/keys        (format: sk_car_...)
# Docs:     https://docs.cartesia.ai
#
# Verified 2026-07-27: auth is `Authorization: Bearer`, API version header is
# 2026-03-01, current TTS model is sonic-3.5.
#
# ⚠️ CLONING IS NOT ON THE FREE TIER. The clone endpoint returns
# 402 plan_upgrade_required. Instant cloning needs Pro ($5/mo); Pro-quality
# cloning needs Startup ($49/mo). See the pricing-structure analysis in
# workplan.md §4 before deciding O-02 — Cartesia sells a fixed monthly credit
# bucket where MiniMax bills per character, and that difference matters more
# than the headline rate.
CARTESIA_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Before picking a winner, check the D-08 constraint
# ─────────────────────────────────────────────────────────────────────────────
# The winning vendor MUST support UNBOUNDED per-user voice clones. Every paying
# user needs their own clone, so any per-plan cap on stored voices is a hard
# wall on total subscribers. ElevenLabs is already disqualified on exactly this.
# Confirm the winner's limit before committing — a cap discovered in September
# is a rebuild, not a config change.
